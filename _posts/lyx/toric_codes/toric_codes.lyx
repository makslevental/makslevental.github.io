reference "2dlattice-1-2-1"

\end_inset


\begin_inset Formula 
\[
\X_{L}^{'}\psi=X_{2,10,11,12}\hat{X}_{L}\psi=\pm\hat{X}_{L}\psi=\pm\psi
\]

\end_inset

where 
\begin_inset Formula $X_{2,10,11,12}$
\end_inset

 is the outcome of the measurement of stabilizer 
\begin_inset Formula $\X_{2}\X_{10}\X_{11}\X_{12}$
\end_inset

.
